<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- -p:BepInExCore=<dir> to use your own BepInEx copy (only Iced.dll is needed here) -->
    <BepInExCore Condition="'$(BepInExCore)' == ''">$(MSBuildThisFileDirectory)../../third_party/bepinex-be788/BepInEx/core</BepInExCore>
  </PropertyGroup>
  <!-- Unity-free unit checks for SyncLogic/GateLogic/SlotLogic/CodeSig (ping colours, car-sync decisions, wire format,
       version gate tiers, host slot allocator, code signatures). Run: dotnet run -->
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net8.0</TargetFramework><ImplicitUsings>disable</ImplicitUsings><Nullable>disable</Nullable><RollForward>Major</RollForward></PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/OthLan.Plugin/SyncLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/NetLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/SmoothLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/GateLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/SlotLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/CodeSig.cs" />
    <Compile Include="../../src/OthLan.Plugin/DiscoveryLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/Loc.cs" />
    <Compile Include="../../src/OthLan.Plugin/UpdateLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/SuspendLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/InteractionLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/PosePlayback.cs" />
    <Compile Include="../../src/OthLan.Plugin/ModLiveryGateLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/SessionLogsLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/DiagLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/FrameCostLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/PoseSpeedLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/WheelSpinLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/UiModalLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/CoopSessionLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/WinchKindLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/CarWire.cs" />
    <Compile Include="../../src/OthLan.Plugin/StatePlayback.cs" />
    <Compile Include="../../src/OthLan.Plugin/RelayLogic.cs" />
    <Compile Include="../../src/OthLan.Plugin/SessionNotifyLogic.cs" />
    <Compile Include="../../src/OthLan.Launch/HangLogic.cs" />
    <EmbeddedResource Include="../../src/OthLan.Plugin/Lang/*.json" LogicalName="lang.%(Filename).json" />
    <Reference Include="$(BepInExCore)/Iced.dll" />
  </ItemGroup>
</Project>
