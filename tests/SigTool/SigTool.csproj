<Project Sdk="Microsoft.NET.Sdk">
  <!-- Computes the address-independent code signatures (CodeSig) of the hooked Fusion methods from a GameAssembly.dll
       file, for manifest/supported-builds.json ("codeSig"). Same algorithm the plugin runs in memory. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <RollForward>Major</RollForward>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/OthLan.Plugin/CodeSig.cs" />
    <Reference Include="../../third_party/bepinex-be788/BepInEx/core/Iced.dll" />
  </ItemGroup>
</Project>
