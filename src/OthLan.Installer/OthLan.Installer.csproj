<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>disable</ImplicitUsings>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <InvariantGlobalization>true</InvariantGlobalization>
    <Nullable>disable</Nullable>
    <AssemblyName>OTH-LAN-Setup</AssemblyName>
    <Version>0.2.3</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace>OthLan.Installer</RootNamespace>
    <Root>$(MSBuildThisFileDirectory)../../</Root>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../..'))=/_/</PathMap>
  </PropertyGroup>
  <PropertyGroup Condition="'$(OthLanPublic)' == 'true'">
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="$(Root)manifest/supported-builds.json" LogicalName="supported-builds.json" />
    <EmbeddedResource Include="$(Root)src/OthLan.Plugin/bin/Release/net6.0/OthLan.dll" LogicalName="OthLan.dll" />
    <!-- Offline payload (redistributable BepInEx LGPL build + BepInEx-hosted Unity base libs). Optional: if absent the installer downloads and sha256-verifies. -->
    <EmbeddedResource Include="$(Root)third_party/BepInEx-Unity.IL2CPP-win-x64-6.0.0-be.788+5b766a3.zip" LogicalName="bepinex.zip" Condition="Exists('$(Root)third_party/BepInEx-Unity.IL2CPP-win-x64-6.0.0-be.788+5b766a3.zip')" />
    <EmbeddedResource Include="$(Root)third_party/unity-libs-6000.0.75.zip" LogicalName="unity-libs.zip" Condition="'$(OthLanPublic)' != 'true' And Exists('$(Root)third_party/unity-libs-6000.0.75.zip')" />
  </ItemGroup>
</Project>
